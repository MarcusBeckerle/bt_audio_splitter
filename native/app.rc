#include <windows.h>
#include "../artifacts/native/version.h"
1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"
200 RCDATA "../artifacts/native/licenses.txt"
1 VERSIONINFO
FILEVERSION APP_VERSION_NUMERIC
PRODUCTVERSION APP_VERSION_NUMERIC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Marcus Beckerle"
            VALUE "FileDescription", "BT Audio Splitter"
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "ProductName", "BT Audio Splitter"
            VALUE "ProductVersion", APP_VERSION_TEXT
            VALUE "LegalCopyright", "Copyright (c) 2026 Marcus Beckerle"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
